# Copy to .env and fill in. .env is gitignored — keep it that way.

# https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
# Reads attached photos and video frames. gemma is the only model on this
# account that handles several images reliably.
SAMBANOVA_VISION_MODEL=gemma-4-31B-it

# https://play.cartesia.ai/keys
CARTESIA_API_KEY=
# sonic-3 speaks all eight languages this demo offers. sonic-2 has no Arabic
# and, since October 2026, no Italian or Dutch — it answers those with "the
# requested model has been sunsetted". Measured over three runs sonic-3 was
# also the faster of the two to first audio, so there is nothing to trade off.
CARTESIA_MODEL=sonic-3
# Where a turn falls back to if the model above stops serving its language.
CARTESIA_MODEL_AR=sonic-3
# Answer without speaking: the conversation, retrieval, vision and search all
# run and the caller reads the reply. Useful for trying things out without
# spending synthesis credits, and for keeping the demo usable if they run out.
TEXT_ONLY=
# Concurrent synthesis streams your Cartesia plan allows (2 on the starter plan).
CARTESIA_CONCURRENCY=2
# Cartesia's public sample voice; swap for your own from the voice library.
CARTESIA_VOICE_ID=6ccbfb76-1fc6-48f7-b71d-91ac6298247b

# Web search. Leave everything blank and the demo scrapes DuckDuckGo's lite
# endpoint, which works without a key but is brittle and rate limited. For
# anything you intend to show people, add one key below and it is used instead.
SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
# Exa is semantic rather than keyword — worth trying for "find me one like
# this", likely worse for current news and named products, and the dearest of
# the four at roughly $7 per 1,000 searches. Untested here; set
# SEARCH_PROVIDER=exa to compare it against Tavily on the same question.
EXA_API_KEY=

# How many messages of conversation the model sees (user, agent and the
# order/search records kept between them).
MAX_HISTORY_MESSAGES=30
# Per browser session. One passphrase and a link that outlives the call is
# otherwise somebody else spending your credits.
MAX_TURNS_PER_SESSION=60
MAX_SESSION_MINUTES=45

# Model per turn when the picker is on Auto. Leave blank to use these.
#   SAMBANOVA_QUICK_MODEL   small talk (default: the smallest Llama on the account)
#   SAMBANOVA_THINK_MODEL   hard questions, reasons while the talker talks (default: gpt-oss-120b)
#   SAMBANOVA_CHECK_MODEL   fact-checks sentences before they are spoken (default: Llama 3.3 70B)
SAMBANOVA_QUICK_MODEL=
SAMBANOVA_THINK_MODEL=
SAMBANOVA_CHECK_MODEL=

# Speed and emotion changes with the caller's mood. Turned off automatically
# for the session if Cartesia refuses them.
CARTESIA_VOICE_CONTROLS=on

# Voices for the specialists a call can be handed to. Blank picks the second
# and third voices on the account.
VOICE_BILLING=
VOICE_TECHNICAL=

# Checking an address. The offline layers — house number, postcode shape,
# and whether the postcode agrees with the town — always run. A real
# validator is extra, costs money and reaches the internet, so it is off
# unless named here: demo, usps, google or smarty. Only "demo" is built;
# the others say so rather than silently passing everything.
VALIDATE_ADDRESS_WITH=

# Whether to look up an email's domain before accepting it. A lookup that
# cannot be made is treated as "do not know", never as a bad address, so
# blocked egress does not tell every caller their email is wrong.
EMAIL_CHECK_DNS=1
EMAIL_DNS_SECONDS=2

# Which country phone numbers are assumed to be from when they are given
# without a country code.
PHONE_REGION=GB

# Verification. A caller gives a name and an email, reads back a code sent
# to it, and only then hears anything personal. Three attempts across voice
# and typing together, then the address is locked for a quarter of an hour.
CODE_MINUTES=10
CODE_ATTEMPTS=3
CODE_LOCKOUT_MINUTES=15
CODES_PER_HOUR=3
# And per caller, across every address they ask about. Without this one
# person can request codes for any number of addresses, which is harmless
# while the code appears on their own screen and a mail bomb the day SMTP
# is switched on.
CODES_PER_CALLER_HOUR=6

# How long call history is kept before it is deleted automatically.
RETENTION_DAYS=30

# How long a database statement waits for another writer.
MEMORY_BUSY_SECONDS=5

# Customer memory (SQLite, created on first run, along with its folder).
# A container points this at a mounted volume, e.g. /data/memory.sqlite3.
MEMORY_FILE=

# Where to listen. Loopback by default, so running it on a laptop does not
# put it on the network; a container sets HOST=0.0.0.0 because the kubelet
# reaches it from outside the pod's network namespace.
HOST=
PORT=8080

# How long a sign-in lasts, in hours. Governs both the cookie and the
# server's memory of it, so the two cannot disagree.
SESSION_HOURS=12

# Turns allowed to be talking to SambaNova at once, across the whole process
# rather than per connection, and how long a turn waits for a slot before the
# caller is told we are busy. Twenty callers at four turns each is eighty
# requests, which is how a rate limit is met.
MAX_CONCURRENT_LLM=8
LLM_QUEUE_SECONDS=6

# Per attached image, after the browser has resized it. Eight of these has to
# fit through MAX_MESSAGE_BYTES, which defaults to exactly that product.
MAX_IMAGE_BYTES=2000000

# Which languages the voice's emotion control is sent for. Blank uses the
# built-in table (all eight); a comma-separated list narrows it; "none" turns
# it off everywhere. A language without emotion keeps pacing and wording.
EMOTION_LANGUAGES=

# Caps on one websocket message and one spoken turn. The first is enforced
# before the frame is parsed; the second trims anything longer and logs it.
MAX_MESSAGE_BYTES=
MAX_PROMPT_CHARS=2000

# Answer without speaking. Everything else — conversation, retrieval, vision,
# search — still runs and the caller reads the reply. The offline tests use
# this, and it keeps a demo usable if synthesis credit runs out.
TEXT_ONLY=

# Passphrase visitors must enter before they can use the demo. Required in
# practice: every turn spends API credit, so the app is never served ungated.
# Leave blank and the server generates a throwaway one and prints it at startup.
DEMO_PASSPHRASE=
