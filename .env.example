# Copy to .env and fill in. .env is gitignored — keep it that way.

# https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# https://play.cartesia.ai/keys
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-2
# Cartesia's public sample voice; swap for your own from the voice library.
CARTESIA_VOICE_ID=6ccbfb76-1fc6-48f7-b71d-91ac6298247b

# Port for server.py
PORT=8080
