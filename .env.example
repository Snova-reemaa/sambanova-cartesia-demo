# Copy to .env and fill in. .env is gitignored — keep it that way.

# https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
# Reads attached photos and video frames. gemma is the only model on this
# account that handles several images reliably.
SAMBANOVA_VISION_MODEL=gemma-4-31B-it

# https://play.cartesia.ai/keys
CARTESIA_API_KEY=
# sonic-3 speaks all eight languages this demo offers. sonic-2 has no Arabic
# and, since October 2026, no Italian or Dutch — it answers those with "the
# requested model has been sunsetted". Measured over three runs sonic-3 was
# also the faster of the two to first audio, so there is nothing to trade off.
CARTESIA_MODEL=sonic-3
# Where a turn falls back to if the model above stops serving its language.
CARTESIA_MODEL_AR=sonic-3
# Concurrent synthesis streams your Cartesia plan allows (2 on the starter plan).
CARTESIA_CONCURRENCY=2
# Cartesia's public sample voice; swap for your own from the voice library.
CARTESIA_VOICE_ID=6ccbfb76-1fc6-48f7-b71d-91ac6298247b

# Web search. Leave everything blank and the demo scrapes DuckDuckGo's lite
# endpoint, which works without a key but is brittle and rate limited. For
# anything you intend to show people, add one key below and it is used instead.
SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
# Exa is semantic rather than keyword — worth trying for "find me one like
# this", likely worse for current news and named products, and the dearest of
# the four at roughly $7 per 1,000 searches. Untested here; set
# SEARCH_PROVIDER=exa to compare it against Tavily on the same question.
EXA_API_KEY=

# How many messages of conversation the model sees (user, agent and the
# order/search records kept between them).
MAX_HISTORY_MESSAGES=30
# Per browser session. One passphrase and a link that outlives the call is
# otherwise somebody else spending your credits.
MAX_TURNS_PER_SESSION=60
MAX_SESSION_MINUTES=45

# Model per turn when the picker is on Auto. Leave blank to use these.
#   SAMBANOVA_QUICK_MODEL   small talk (default: the smallest Llama on the account)
#   SAMBANOVA_THINK_MODEL   hard questions, reasons while the talker talks (default: gpt-oss-120b)
#   SAMBANOVA_CHECK_MODEL   fact-checks sentences before they are spoken (default: Llama 3.3 70B)
SAMBANOVA_QUICK_MODEL=
SAMBANOVA_THINK_MODEL=
SAMBANOVA_CHECK_MODEL=

# Speed and emotion changes with the caller's mood. Turned off automatically
# for the session if Cartesia refuses them.
CARTESIA_VOICE_CONTROLS=on

# Voices for the specialists a call can be handed to. Blank picks the second
# and third voices on the account.
VOICE_BILLING=
VOICE_TECHNICAL=

# Customer memory (SQLite, created on first run).
MEMORY_FILE=

# Port for server.py
PORT=8080

# Passphrase visitors must enter before they can use the demo. Required in
# practice: every turn spends API credit, so the app is never served ungated.
# Leave blank and the server generates a throwaway one and prints it at startup.
DEMO_PASSPHRASE=
